<Window x:Class="CodeSigner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodeSigner.App"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="代码签名工具"
        Icon="Assets/CodeSigner.ico"
        Width="1180"
        Height="940"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.AutomationId="SigningWorkbenchWindow"
        AutomationProperties.Name="代码签名工具签名工作台">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CompactQueueHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="4,8" />
        </Style>
        <Style x:Key="CompactQueueCellTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="MaxHeight" Value="32" />
        </Style>
        <DataTemplate x:Key="CertificateOptionTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding AutomationName}"
                       AutomationProperties.Name="{Binding AutomationName}" />
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource Brush.PageBackground}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="AppHeader" Grid.Row="0" Margin="0,0,0,12" Padding="4,2" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{DynamicResource Color.Accent.Subtle}" CornerRadius="8">
                        <Image Width="20"
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Focusable="False"
                               IsHitTestVisible="False"
                               Source="{StaticResource Icon.Decorative.WorkbenchShield}"
                               Stretch="Uniform"
                               AutomationProperties.Name="代码签名工具" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="代码签名工具" />
                        <TextBlock Margin="0,1,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Color.Text.Secondary}"
                                   Text="安全签名工作台" />
                    </StackPanel>
                </StackPanel>
                <Image Grid.Column="1"
                       Width="28"
                       Height="28"
                       VerticalAlignment="Center"
                       Focusable="False"
                       IsHitTestVisible="False"
                       Source="Assets/CodeSigner.png"
                       Stretch="Uniform"
                       ToolTip="Windows 支持格式签名"
                       automation:AutomationProperties.Name="Windows 支持格式签名" />
            </Grid>
        </Border>

        <Border x:Name="ReadinessBand"
                Grid.Row="1"
                Margin="0,0,0,12"
                Style="{StaticResource BandBorderStyle}"
                Background="{DynamicResource Brush.ReadinessBackground}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="15*" />
                    <ColumnDefinition Width="12*" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ClipToBounds="True" ToolTip="{Binding WorkstationStatus}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="16"
                           Height="16"
                           Focusable="True"
                           Source="{StaticResource Icon.Status.Workstation}"
                           Stretch="Uniform"
                           AutomationProperties.AutomationId="ReadinessWorkstation"
                           AutomationProperties.Name="{Binding WorkstationStatus}" />
                    <TextBlock x:Name="WorkstationStatusText"
                               Grid.Column="1"
                               Margin="8,0,4,0"
                               VerticalAlignment="Center"
                               Text="{Binding WorkstationStatus}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="ReadinessWorkstationText" />
                </Grid>
                <Grid Grid.Column="1" ClipToBounds="True" ToolTip="{Binding NativeApiStatus}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="16"
                           Height="16"
                           Focusable="True"
                           Source="{StaticResource Icon.Status.NativeApi}"
                           Stretch="Uniform"
                           AutomationProperties.AutomationId="ReadinessNativeApi"
                           AutomationProperties.Name="{Binding NativeApiStatus}" />
                    <TextBlock x:Name="NativeApiStatusText"
                               Grid.Column="1"
                               Margin="8,0,4,0"
                               VerticalAlignment="Center"
                               Text="{Binding NativeApiStatus}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="ReadinessNativeApiText" />
                </Grid>
                <Grid Grid.Column="2" ClipToBounds="True" ToolTip="{Binding SimplySignStatus}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="16"
                           Height="16"
                           Focusable="True"
                           Source="{StaticResource Icon.Status.SimplySign}"
                           Stretch="Uniform"
                           AutomationProperties.AutomationId="ReadinessSimplySign"
                           AutomationProperties.Name="{Binding SimplySignStatus}" />
                    <TextBlock x:Name="SimplySignStatusText"
                               Grid.Column="1"
                               Margin="8,0,4,0"
                               VerticalAlignment="Center"
                               Text="{Binding SimplySignStatus}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="ReadinessSimplySignText" />
                </Grid>
                <Grid Grid.Column="3" ClipToBounds="True" ToolTip="{Binding CertificateStatus}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="16"
                           Height="16"
                           Focusable="True"
                           Source="{StaticResource Icon.Status.Certificate}"
                           Stretch="Uniform"
                           AutomationProperties.AutomationId="ReadinessCertificates"
                           AutomationProperties.Name="{Binding CertificateStatus}" />
                    <TextBlock x:Name="CertificateStatusText"
                               Grid.Column="1"
                               Margin="8,0,4,0"
                               VerticalAlignment="Center"
                               Text="{Binding CertificateStatus}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="ReadinessCertificatesText" />
                </Grid>
                <Grid Grid.Column="4" ClipToBounds="True" ToolTip="{Binding TimestampStatus}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="16"
                           Height="16"
                           Focusable="True"
                           Source="{StaticResource Icon.Status.Timestamp}"
                           Stretch="Uniform"
                           AutomationProperties.AutomationId="TimestampStatus"
                           AutomationProperties.Name="{Binding TimestampStatus}" />
                    <TextBlock x:Name="TimestampStatusText"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding TimestampStatus}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="ReadinessTimestampText" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="CommandBand" Grid.Row="2" Margin="0,0,0,12" Style="{StaticResource BandBorderStyle}" Padding="10,6">
            <StackPanel>
                <WrapPanel x:Name="CommandActionsPanel">
                    <Button x:Name="AddFilesButton"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="AddFiles_Click"
                            ToolTip="添加支持的签名文件到队列"
                            AutomationProperties.AutomationId="AddFilesButton"
                            AutomationProperties.Name="添加签名文件"
                            AutomationProperties.HelpText="添加一个或多个支持的签名文件到队列">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.AddFile}" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="AddFolderButton"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="AddFolder_Click"
                            ToolTip="添加包含支持签名文件的文件夹"
                            AutomationProperties.AutomationId="AddFolderButton"
                            AutomationProperties.Name="添加签名文件夹"
                            AutomationProperties.HelpText="选择一个文件夹，系统自动识别其中支持的签名文件">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.AddFolder}" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CommandButtonStyle}"
                            Command="{Binding RemoveCommand}"
                            ToolTip="从队列中移除选中的项"
                            AutomationProperties.AutomationId="RemoveButton"
                            AutomationProperties.Name="从队列移除选中的签名文件"
                            AutomationProperties.HelpText="仅从内存队列移除选中的项目，不删除源文件">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Remove}" Stretch="Uniform" />
                    </Button>
                    <Border Width="1" Height="28" Margin="5,4,9,4" Background="{DynamicResource Color.Border.Subtle}" />
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource CommandButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="刷新准备状态"
                            AutomationProperties.AutomationId="RefreshButton"
                            AutomationProperties.Name="刷新就绪状态"
                            AutomationProperties.HelpText="重新检查 Windows 签名 API、SimplySign、证书和时间戳">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Refresh}" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CommandButtonStyle}"
                            Command="{Binding RetryCommand}"
                            ToolTip="重试当前失败或暂停的文件"
                            AutomationProperties.AutomationId="RetryButton"
                            AutomationProperties.Name="重试失败或暂停的签名文件"
                            AutomationProperties.HelpText="从原始文件重试失败或暂停的签名文件项目">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Retry}" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CommandButtonStyle}"
                            Command="{Binding OpenOutputCommand}"
                            ToolTip="打开输出目录"
                            AutomationProperties.AutomationId="OpenOutputButton"
                            AutomationProperties.Name="打开输出目录"
                            AutomationProperties.HelpText="在文件资源管理器中打开当前输出目录">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.OpenOutput}" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CommandButtonStyle}"
                            Command="{Binding ExportDiagnosticsCommand}"
                            ToolTip="导出诊断信息"
                            AutomationProperties.AutomationId="ExportDiagnosticsButton"
                            AutomationProperties.Name="导出诊断信息"
                            AutomationProperties.HelpText="导出不包含凭据和私钥的诊断文件">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.ExportDiagnostics}" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="OpenLogDirectoryButton"
                            Style="{StaticResource CommandButtonStyle}"
                            Command="{Binding OpenLogDirectoryCommand}"
                            ToolTip="打开本地日志目录"
                            AutomationProperties.AutomationId="OpenLogDirectoryButton"
                            AutomationProperties.Name="打开日志目录"
                            AutomationProperties.HelpText="在文件资源管理器中打开本机日志目录：%LOCALAPPDATA%\CodeSigner\Diagnostics">
                        <TextBlock>
                            <InlineUIContainer BaselineAlignment="Center">
                                <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.OpenLogs}" Stretch="Uniform" />
                            </InlineUIContainer>
                        </TextBlock>
                    </Button>
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="Settings_Click"
                            ToolTip="打开设置（时间戳、诊断保留期等）"
                            AutomationProperties.AutomationId="SettingsButton"
                            AutomationProperties.Name="签名设置"
                            AutomationProperties.HelpText="设置时间戳地址和诊断保留期限">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Settings}" Stretch="Uniform" />
                    </Button>
                </WrapPanel>

                <local:WorkerRecoveryGroupBox x:Name="WorkerRecoveryRegion"
                                              Margin="0,6,0,0"
                                              Padding="0,8,0,0"
                                              BorderBrush="{DynamicResource Color.Border.Subtle}"
                                              BorderThickness="0,1,0,0"
                                              Focusable="True"
                                              Visibility="{Binding IsWorkerRecoveryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              AutomationProperties.AutomationId="WorkerRecoveryRegion"
                                              AutomationProperties.Name="{Binding WorkerRecoveryAutomationName}"
                                              AutomationProperties.HelpText="{Binding WorkerRecoveryHelpText}"
                                              automation:AutomationProperties.LiveSetting="Assertive">
                    <Grid x:Name="WorkerRecoveryGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="WorkerRecoveryMessageColumn" Width="*" />
                            <ColumnDefinition x:Name="WorkerRecoveryActionsColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WorkerRecoveryMessageText"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Color.Text.Primary}"
                                   Text="{Binding WorkerRecoveryMessage}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding WorkerRecoveryHelpText}"
                                   AutomationProperties.Name="{Binding WorkerRecoveryAutomationName}"
                                   AutomationProperties.HelpText="{Binding WorkerRecoveryHelpText}"
                                   automation:AutomationProperties.LiveSetting="Assertive" />
                        <WrapPanel x:Name="WorkerRecoveryActionsPanel"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Right">
                            <Button Style="{StaticResource CommandButtonStyle}"
                                    Content="重新检测 Worker"
                                    Command="{Binding RefreshWorkerCommand}"
                                    ToolTip="重新检测 Worker 健康状态"
                                    AutomationProperties.AutomationId="RefreshWorkerButton"
                                    AutomationProperties.Name="重新检测 Worker"
                                    AutomationProperties.HelpText="重新运行 Worker 健康检查；不更改队列、设置或原始文件" />
                            <Button Style="{StaticResource CommandButtonStyle}"
                                    Content="修复 Worker"
                                    Command="{Binding RepairWorkerCommand}"
                                    ToolTip="仅重新安装 Worker 组件；确认后将显示 UAC"
                                    Visibility="{Binding IsWorkerRepairOffered, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="RepairWorkerButton"
                                    AutomationProperties.Name="修复 Worker"
                                    AutomationProperties.HelpText="确认后将显示 Windows 用户帐户控制（UAC）；只重新安装 Worker，完成后自动重新检测，不会自动签名" />
                            <Button Style="{StaticResource CommandButtonStyle}"
                                    Content="打开安装目录"
                                    Command="{Binding OpenInstallationDirectoryCommand}"
                                    ToolTip="打开 CodeSigner 安装目录"
                                    AutomationProperties.AutomationId="OpenInstallationDirectoryButton"
                                    AutomationProperties.Name="打开安装目录"
                                    AutomationProperties.HelpText="在文件资源管理器中打开包含应用和 Worker 的安装目录" />
                        </WrapPanel>
                    </Grid>
                </local:WorkerRecoveryGroupBox>
            </StackPanel>
        </Border>

        <Border x:Name="ConfigurationBand" Grid.Row="3" Margin="0,0,0,12" Padding="0" Background="Transparent">
            <Grid x:Name="ConfigurationGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ConfigurationColumn" Width="*" />
                    <ColumnDefinition x:Name="DetailsColumn" Width="400" />
                </Grid.ColumnDefinitions>

                <Border x:Name="CertificateDetailsPanel" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Grid x:Name="CertificateDetailsContent" Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,8" Orientation="Horizontal">
                            <Image Width="18"
                                   Height="18"
                                   Focusable="False"
                                   IsHitTestVisible="False"
                                   Source="{StaticResource Icon.Section.Certificate}"
                                   Stretch="Uniform" />
                            <TextBlock Margin="8,0,0,0" FontSize="17" FontWeight="SemiBold" Text="证书信息" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{DynamicResource Color.Text.Secondary}" Text="主题" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,0,12,0"
                                   Text="{Binding PrimaryCertificate.Subject}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PrimaryCertificate.Subject}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource Color.Text.Secondary}" Text="颁发者" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Text="{Binding PrimaryCertificate.Issuer}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PrimaryCertificate.Issuer}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,7,0,0" Foreground="{DynamicResource Color.Text.Secondary}" Text="有效期" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7,12,0" Text="{Binding PrimaryCertificate.Expiry}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,7,0,0" Foreground="{DynamicResource Color.Text.Secondary}" Text="存储位置" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,7,0,0" Text="{Binding PrimaryCertificate.Store}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,7,0,0" Foreground="{DynamicResource Color.Text.Secondary}" Text="指纹" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Margin="0,7,0,0"
                                 Padding="0"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="12"
                                 Text="{Binding PrimaryCertificate.Thumbprint, Mode=OneWay}"
                                 ToolTip="{Binding PrimaryCertificate.Thumbprint}"
                                 AutomationProperties.AutomationId="PrimaryCertificateThumbprint"
                                 AutomationProperties.Name="主证书完整指纹"
                                 AutomationProperties.HelpText="只读证书指纹，可复制，不包含私钥" />
                    </Grid>
                </Border>

                <Border x:Name="ConfigurationPanel" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <Grid x:Name="ConfigurationContent" Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="SigningPolicyHeading" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <Image Width="18"
                                   Height="18"
                                   Focusable="False"
                                   IsHitTestVisible="False"
                                   Source="{StaticResource Icon.Section.SigningPolicy}"
                                   Stretch="Uniform" />
                            <TextBlock Margin="8,0,0,0" FontSize="17" FontWeight="SemiBold" Text="签名策略" />
                        </StackPanel>
                        <StackPanel x:Name="SigningModePanel"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,8,0,0"
                                    Orientation="Horizontal"
                                    AutomationProperties.AutomationId="SigningModeGroup"
                                    AutomationProperties.Name="签名模式">
                            <RadioButton Style="{StaticResource SegmentedRadioButtonStyle}"
                                         GroupName="SigningMode"
                                         Content="单签（SHA-256）"
                                         IsChecked="{Binding IsSingleMode, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="SigningModeSingle"
                                         AutomationProperties.Name="SHA-256 单签模式"
                                         AutomationProperties.HelpText="使用 SHA-256 证书进行单次签名" />
                            <RadioButton Margin="4,0,0,0"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         GroupName="SigningMode"
                                         Content="双签（SHA-1 + SHA-256）"
                                         IsChecked="{Binding IsDualMode, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="SigningModeDual"
                                         AutomationProperties.Name="SHA-1 加 SHA-256 双签模式"
                                         AutomationProperties.HelpText="先使用 SHA-1，再追加 SHA-256 签名" />
                        </StackPanel>
                        <TextBlock x:Name="PrimaryCertificateLabel"
                                   Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Margin="0,12,0,0"
                                   FontWeight="SemiBold"
                                   Text="主证书" />
                        <ComboBox x:Name="PrimaryCertificateCombo"
                                  Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  Margin="0,5,0,0"
                                  Style="{StaticResource CertificateComboBoxStyle}"
                                  ItemsSource="{Binding Certificates}"
                                  SelectedItem="{Binding PrimaryCertificate}"
                                  ItemTemplate="{StaticResource CertificateOptionTemplate}"
                                  ToolTip="{Binding PrimaryCertificate.AutomationName}"
                                  AutomationProperties.AutomationId="PrimaryCertificateCombo"
                                  AutomationProperties.Name="主签名证书"
                                  AutomationProperties.HelpText="{Binding PrimaryCertificate.AutomationName}" />
                        <TextBlock x:Name="SecondaryCertificateLabel"
                                   Grid.Row="4"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   FontWeight="SemiBold"
                                   Text="辅助证书（SHA-256）"
                                   Visibility="{Binding IsDualMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ComboBox x:Name="SecondaryCertificateCombo"
                                  Grid.Row="5"
                                  Grid.ColumnSpan="2"
                                  Margin="0,5,0,0"
                                  Style="{StaticResource CertificateComboBoxStyle}"
                                  ItemsSource="{Binding Certificates}"
                                  SelectedItem="{Binding SecondaryCertificate}"
                                  ItemTemplate="{StaticResource CertificateOptionTemplate}"
                                  ToolTip="{Binding SecondaryCertificate.AutomationName}"
                                  Visibility="{Binding IsDualMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.AutomationId="SecondaryCertificateCombo"
                                  AutomationProperties.Name="SHA-256 辅助签名证书"
                                  AutomationProperties.HelpText="{Binding SecondaryCertificate.AutomationName}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="QueueRegion" Grid.Row="4" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="QueueHeader" Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QueueHeading"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="文件任务队列"
                           AutomationProperties.AutomationId="QueueHeading" />
                <TextBlock x:Name="QueueSupportCopy"
                           Grid.Column="1"
                           Foreground="{DynamicResource Color.Text.Tertiary}"
                           Text="支持 PE、安装包、目录和脚本签名文件"
                           AutomationProperties.AutomationId="QueueSupportCopy" />
            </Grid>
            <Grid x:Name="QueueBody" Grid.Row="1" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="QueueGrid"
                          Grid.Row="0"
                          Style="{StaticResource WorkbenchDataGridStyle}"
                          RowHeight="50"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding Rows}"
                          CurrentCellChanged="QueueGrid_CurrentCellChanged"
                          SelectionChanged="QueueGrid_SelectionChanged"
                          AutomationProperties.AutomationId="SigningQueueGrid"
                          AutomationProperties.Name="签名文件队列与结果">
                    <DataGrid.ItemContainerStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            <Setter Property="ToolTip" Value="{Binding AutomationName}" />
                        </Style>
                    </DataGrid.ItemContainerStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="FileColumn" Width="2*" MinWidth="180" Header="文件输入">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="10,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding FullPath}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FullPath}"
                                               AutomationProperties.Name="{Binding FullPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="FormatColumn"
                                            Width="132"
                                            MinWidth="112"
                                            Header="检测格式"
                                            Binding="{Binding FormatText}" />
                        <DataGridTextColumn x:Name="EngineColumn"
                                            Width="124"
                                            MinWidth="108"
                                            Header="签名引擎"
                                            Binding="{Binding EngineText}" />
                        <DataGridTextColumn x:Name="PolicyColumn"
                                            Width="124"
                                            MinWidth="108"
                                            Header="有效策略"
                                            Binding="{Binding EffectivePolicyText}" />
                        <DataGridTextColumn x:Name="StateColumn" Width="144" Header="状态" Binding="{Binding StateText}" />
                        <DataGridTemplateColumn x:Name="ProgressColumn" Width="136" Header="进度">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0"
                                                     Height="8"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     AutomationProperties.Name="{Binding AutomationName}" />
                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ResultColumn" Width="*" MinWidth="180" Header="结果">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="10,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding ResultText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DetailText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ActionColumn" Width="58" MinWidth="58" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                     <Button Style="{StaticResource CommandButtonStyle}"
                                             Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                             CommandParameter="{Binding}"
                                             ToolTip="从队列中移除此文件，不删除源文件"
                                             AutomationProperties.AutomationId="{Binding RemoveAutomationId}"
                                             AutomationProperties.Name="从队列移除此签名文件"
                                            AutomationProperties.HelpText="仅从内存队列移除，不删除、覆盖或改变源文件">
                                        <Image Width="16"
                                               Height="16"
                                               Focusable="False"
                                               IsHitTestVisible="False"
                                               Source="{StaticResource Icon.Command.Remove}"
                                               Stretch="Uniform" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button x:Name="QueueDirectAddButton"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="12,8"
                        Click="AddFiles_Click"
                        ToolTip="选择一个或多个支持的签名文件并加入队列"
                        AutomationProperties.AutomationId="QueueDirectAddButton"
                        AutomationProperties.Name="直接添加签名文件"
                        AutomationProperties.HelpText="打开文件选择器，将一个或多个支持的签名文件加入队列">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}">
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Grid.RowSpan" Value="1" />
                            <Setter Property="Margin" Value="1,6,1,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Grid.Row" Value="0" />
                                    <Setter Property="Grid.RowSpan" Value="2" />
                                    <Setter Property="Margin" Value="1,38,1,1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWorkerRecoveryVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="16"
                               Height="16"
                               Focusable="False"
                               IsHitTestVisible="False"
                               Source="{StaticResource Icon.Command.AddFile}"
                               Stretch="Uniform" />
                        <TextBlock x:Name="QueueDirectAddPrompt"
                                   Margin="6,0,0,0"
                                   Foreground="{DynamicResource Color.Text.Secondary}"
                                   Text="添加签名文件"
                                   AutomationProperties.AutomationId="QueueDirectAddPrompt"
                                   AutomationProperties.Name="添加支持的签名文件或文件夹" />
                    </StackPanel>
                </Button>
                <local:AccessibleWatermarkText x:Name="WatermarkText"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,20,10"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Color.Accent.Primary}"
                                                Opacity="0.10"
                                                IsHitTestVisible="False"
                                                Focusable="False"
                                                Text="安徽斯百德信息技术有限公司"
                                                RenderTransformOrigin="0.5,0.5">
                    <local:AccessibleWatermarkText.RenderTransform>
                        <RotateTransform Angle="-8" />
                    </local:AccessibleWatermarkText.RenderTransform>
                    <local:AccessibleWatermarkText.Effect>
                        <BlurEffect Radius="1" />
                    </local:AccessibleWatermarkText.Effect>
                </local:AccessibleWatermarkText>
            </Grid>
        </Grid>

        <Border x:Name="ActionBand" Grid.Row="5" Margin="0,0,0,8" Style="{StaticResource CardBorderStyle}" Padding="14,12">
            <Grid>
                <Grid x:Name="FullActionRail">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,0,5"
                               FontWeight="SemiBold"
                               Text="输出目录" />
                    <TextBox x:Name="OutputRootTextBox"
                             Grid.Row="1"
                             Grid.Column="0"
                             MinHeight="36"
                             Padding="10,5"
                             Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}"
                             LostKeyboardFocus="OutputRootTextBox_LostKeyboardFocus"
                             ToolTip="输出目录路径（完整路径可编辑）"
                             AutomationProperties.AutomationId="OutputRootTextBox"
                             AutomationProperties.Name="输出目录"
                             AutomationProperties.HelpText="{Binding OutputError}" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Width="78"
                            Height="36"
                            Margin="8,0,0,0"
                            Click="BrowseOutput_Click"
                            ToolTip="选择输出目录"
                            AutomationProperties.AutomationId="BrowseOutputButton"
                            AutomationProperties.Name="浏览输出目录"
                            AutomationProperties.HelpText="选择用于保存已验证签名文件输出的目录">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.BrowseOutput}" Stretch="Uniform" />
                            <TextBlock Margin="6,0,0,0" Text="浏览" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource CommandButtonStyle}"
                            Margin="8,0,0,0"
                            Command="{Binding OpenOutputCommand}"
                            ToolTip="打开输出目录"
                            AutomationProperties.AutomationId="ActionOpenOutputButton"
                            AutomationProperties.Name="打开输出目录"
                            AutomationProperties.HelpText="在文件资源管理器中打开当前输出目录">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.OpenOutput}" Stretch="Uniform" />
                    </Button>
                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <ProgressBar Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding AggregateProgressPercent, Mode=OneWay}"
                                         AutomationProperties.AutomationId="AggregateProgress"
                                         AutomationProperties.Name="{Binding StatusMessage}"
                                         automation:AutomationProperties.LiveSetting="Polite" />
                             <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource Color.Text.Secondary}"
                                       Text="{Binding CurrentFileStatusText}"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding CurrentFileStatusText}"
                                       AutomationProperties.AutomationId="SelectedFileDisabledReason"
                                       AutomationProperties.Name="{Binding CurrentFileStatusText}" />
                        </StackPanel>
                        <Button x:Name="SignButton"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Command="{Binding SignCommand}"
                                AutomationProperties.AutomationId="SignButton"
                                ToolTip="签名当前文件"
                                AutomationProperties.Name="开始签名"
                                AutomationProperties.HelpText="{Binding CurrentFileStatusText}">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Sign}" Stretch="Uniform" />
                                <TextBlock Margin="6,0,0,0" Text="{Binding SignButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton"
                                Grid.Column="2"
                                Width="88"
                                Height="42"
                                Margin="8,0,0,0"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="CancelButton"
                                ToolTip="停止当前签名并保留原始文件"
                                AutomationProperties.Name="取消签名"
                                AutomationProperties.HelpText="停止当前签名，原始文件保持不变">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Cancel}" Stretch="Uniform" />
                                <TextBlock Margin="6,0,0,0" Text="取消" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Grid x:Name="CompactActionRail" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CompactOutputRootTextBox"
                             Grid.Row="0"
                             Grid.Column="0"
                             MinHeight="36"
                             Padding="8,4"
                             Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}"
                             LostKeyboardFocus="OutputRootTextBox_LostKeyboardFocus"
                             ToolTip="输出目录路径（完整路径可编辑）"
                             AutomationProperties.AutomationId="OutputRootTextBox"
                             AutomationProperties.Name="输出目录"
                             AutomationProperties.HelpText="{Binding OutputError}" />
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource CommandButtonStyle}"
                            Margin="8,0,0,0"
                            Click="BrowseOutput_Click"
                            ToolTip="浏览并选择输出目录"
                            AutomationProperties.AutomationId="BrowseOutputButton"
                            AutomationProperties.Name="浏览输出目录"
                            AutomationProperties.HelpText="选择用于保存已验证签名文件输出的目录">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.BrowseOutput}" Stretch="Uniform" />
                    </Button>
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            x:Name="CompactOpenOutputButton"
                            Style="{StaticResource CommandButtonStyle}"
                            Margin="4,0,0,0"
                            Command="{Binding OpenOutputCommand}"
                            ToolTip="打开输出目录"
                            AutomationProperties.AutomationId="ActionOpenOutputButton"
                            AutomationProperties.Name="打开输出目录"
                            AutomationProperties.HelpText="在文件资源管理器中打开当前输出目录">
                        <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.OpenOutput}" Stretch="Uniform" />
                    </Button>
                    <Menu x:Name="UltraCommandButtons"
                          Grid.Row="0"
                          Grid.Column="3"
                          Margin="4,0,0,0"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          Visibility="Collapsed">
                        <MenuItem x:Name="CompactOverflowButton"
                                  MinHeight="36"
                                  Padding="8,6"
                                  ToolTip="显示紧凑布局中的更多操作"
                                  AutomationProperties.AutomationId="CompactOverflowButton"
                                  AutomationProperties.Name="更多操作"
                                  AutomationProperties.HelpText="打开更多操作菜单，可添加或移除文件、刷新状态、打开日志和设置">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Overflow}" Stretch="Uniform" />
                                    <TextBlock Margin="6,0,0,0" Text="更多操作" />
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="添加签名文件"
                                      Click="AddFiles_Click"
                                      ToolTip="添加支持的签名文件到队列"
                                      AutomationProperties.AutomationId="AddFilesButton"
                                      AutomationProperties.Name="添加签名文件"
                                      AutomationProperties.HelpText="添加一个或多个支持的签名文件到队列">
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.AddFile}" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="添加签名文件夹"
                                      Click="AddFolder_Click"
                                      ToolTip="添加包含支持签名文件的文件夹"
                                      AutomationProperties.AutomationId="AddFolderButton"
                                      AutomationProperties.Name="添加签名文件夹"
                                      AutomationProperties.HelpText="选择一个文件夹，系统自动识别其中支持的签名文件">
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.AddFolder}" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="移除选中项"
                                      Command="{Binding RemoveCommand}"
                                      ToolTip="从队列中移除选中的项"
                                      AutomationProperties.AutomationId="RemoveButton"
                                      AutomationProperties.Name="从队列移除选中的签名文件"
                                      AutomationProperties.HelpText="仅从内存队列移除选中的项目，不删除源文件">
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Remove}" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="刷新就绪状态"
                                      Command="{Binding RefreshCommand}"
                                      ToolTip="刷新准备状态"
                                      AutomationProperties.AutomationId="RefreshButton"
                                      AutomationProperties.Name="刷新就绪状态"
                                      AutomationProperties.HelpText="重新检查 Windows 签名 API、SimplySign、证书和时间戳">
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Refresh}" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="重试失败项"
                                      Command="{Binding RetryCommand}"
                                      ToolTip="重试当前失败或暂停的文件"
                                      AutomationProperties.AutomationId="RetryButton"
                                      AutomationProperties.Name="重试失败或暂停的签名文件"
                                      AutomationProperties.HelpText="从原始文件重试失败或暂停的签名文件项目">
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Retry}" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="打开输出目录"
                                      Command="{Binding OpenOutputCommand}"
                                      ToolTip="打开输出目录"
                                      AutomationProperties.AutomationId="OpenOutputButton"
                                      AutomationProperties.Name="打开输出目录"
                                      AutomationProperties.HelpText="在文件资源管理器中打开当前输出目录">
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.OpenOutput}" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="导出诊断信息"
                                      Command="{Binding ExportDiagnosticsCommand}"
                                      ToolTip="导出诊断信息"
                                      AutomationProperties.AutomationId="ExportDiagnosticsButton"
                                      AutomationProperties.Name="导出诊断信息"
                                      AutomationProperties.HelpText="导出不包含凭据和私钥的诊断文件">
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.ExportDiagnostics}" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="打开日志目录"
                                      Command="{Binding OpenLogDirectoryCommand}"
                                      ToolTip="打开本地日志目录"
                                      AutomationProperties.AutomationId="OpenLogDirectoryButton"
                                      AutomationProperties.Name="打开日志目录"
                                      AutomationProperties.HelpText="在文件资源管理器中打开本机日志目录：%LOCALAPPDATA%\CodeSigner\Diagnostics">
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.OpenLogs}" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="签名设置"
                                      Click="Settings_Click"
                                      ToolTip="打开设置（时间戳、诊断保留期等）"
                                      AutomationProperties.AutomationId="SettingsButton"
                                      AutomationProperties.Name="签名设置"
                                      AutomationProperties.HelpText="设置时间戳地址和诊断保留期限">
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Settings}" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                    <Button x:Name="CompactSignButton"
                            Grid.Row="0"
                            Grid.Column="4"
                            Margin="4,0,0,0"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding SignCommand}"
                            AutomationProperties.AutomationId="SignButton"
                            ToolTip="签名当前文件"
                            AutomationProperties.Name="开始签名"
                            AutomationProperties.HelpText="{Binding CurrentFileStatusText}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Sign}" Stretch="Uniform" />
                            <TextBlock Margin="6,0,0,0" Text="{Binding SignButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CompactCancelButton"
                            Grid.Row="0"
                            Grid.Column="5"
                            Width="88"
                            Height="40"
                            Margin="4,0,0,0"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="CancelButton"
                            ToolTip="停止当前签名并保留原始文件"
                            AutomationProperties.Name="取消签名"
                            AutomationProperties.HelpText="停止当前签名，原始文件保持不变">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Command.Cancel}" Stretch="Uniform" />
                            <TextBlock Margin="6,0,0,0" Text="取消" />
                        </StackPanel>
                    </Button>
                    <ProgressBar x:Name="CompactProgress"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="6"
                                 Height="4"
                                 Margin="0,5,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding AggregateProgressPercent, Mode=OneWay}"
                                 AutomationProperties.AutomationId="AggregateProgress"
                                 AutomationProperties.Name="{Binding StatusMessage}"
                                 automation:AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SummaryBand" Grid.Row="6" Margin="0,0,0,8" Padding="12,7" Background="{DynamicResource Color.Surface.Summary}" BorderBrush="{DynamicResource Color.Border.Subtle}" BorderThickness="1" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentItem.DetailText}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentItem.DetailText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="SummaryRegion"
                       Focusable="True"
                       Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusMessage}"
                       AutomationProperties.AutomationId="SummaryRegion"
                       AutomationProperties.Name="{Binding StatusMessage}"
                       automation:AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Border x:Name="RuntimeErrorBand"
                Grid.Row="7"
                Padding="12,8"
                Background="{DynamicResource Color.Status.ErrorBackground}"
                BorderBrush="{DynamicResource Color.Status.ErrorBorder}"
                BorderThickness="1"
                CornerRadius="8"
                automation:AutomationProperties.LiveSetting="Assertive">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentItem.DetailText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentItem.DetailText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Width="16"
                       Height="16"
                       Margin="0,0,8,0"
                       Focusable="False"
                       IsHitTestVisible="False"
                       Source="{StaticResource Icon.Status.Error}"
                       Stretch="Uniform" />
                <TextBlock x:Name="RuntimeError"
                           Grid.Column="1"
                           Focusable="True"
                           Style="{StaticResource ValidationTextStyle}"
                           Margin="0"
                            Text="{Binding CurrentItem.DetailText}"
                            AutomationProperties.AutomationId="RuntimeError"
                            AutomationProperties.Name="{Binding CurrentItem.DetailText}"
                           automation:AutomationProperties.LiveSetting="Assertive" />
            </Grid>
        </Border>

        <Border Grid.Row="8" Padding="12,8" Background="{DynamicResource Color.Status.ErrorBackground}" BorderBrush="{DynamicResource Color.Status.ErrorBorder}" BorderThickness="1" CornerRadius="8" automation:AutomationProperties.LiveSetting="Assertive">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding InputError}" Value="" />
                                <Condition Binding="{Binding OutputError}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding InputError}" Value="{x:Null}" />
                                <Condition Binding="{Binding OutputError}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False" Source="{StaticResource Icon.Status.Error}" Stretch="Uniform" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="InputError"
                               Focusable="True"
                               Text="{Binding InputError}"
                               AutomationProperties.AutomationId="InputError"
                               AutomationProperties.Name="{Binding InputError}"
                               automation:AutomationProperties.LiveSetting="Assertive">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ValidationTextStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InputError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding OutputError}"
                               AutomationProperties.AutomationId="OutputError"
                               AutomationProperties.Name="{Binding OutputError}"
                               automation:AutomationProperties.LiveSetting="Assertive">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ValidationTextStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutputError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
