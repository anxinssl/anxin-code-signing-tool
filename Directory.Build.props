<Project>
  <PropertyGroup>
    <CodeSignerProductVersion>1.0.44</CodeSignerProductVersion>
    <CodeSignerAssemblyVersion>1.0.44.0</CodeSignerAssemblyVersion>
    <CodeSignerFileVersion>1.0.44.0</CodeSignerFileVersion>
    <CodeSignerInformationalVersion>1.0.44</CodeSignerInformationalVersion>
    <CodeSignerProductCode>{E59DA367-7017-4A82-B1EC-C2E751FAAA48}</CodeSignerProductCode>
    <CodeSignerUpgradeCode>{C81BF087-67D0-41F3-8581-9E773813118B}</CodeSignerUpgradeCode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <Version>$(CodeSignerProductVersion)</Version>
    <Product>安信代码签名证书工具</Product>
    <Company>安徽斯百德信息技术有限公司</Company>
    <Copyright>Copyright (C) 2026 安徽斯百德信息技术有限公司</Copyright>
    <AssemblyVersion>$(CodeSignerAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(CodeSignerFileVersion)</FileVersion>
    <InformationalVersion>$(CodeSignerInformationalVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1605</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CodeSignerInstallerPublish)' == 'true'">
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)release/metadata/installer-locks/$(MSBuildProjectName).packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
