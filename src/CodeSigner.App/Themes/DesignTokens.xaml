<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Assets/CommandIcons/LucideCommandIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Color.Surface.Primary" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Color.Surface.Secondary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Color.Surface.Elevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Color.Surface.Inset" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Color.Surface.Header" Color="#F7F7F7" />
    <SolidColorBrush x:Key="Color.Surface.Summary" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Color.Text.Primary" Color="#202020" />
    <SolidColorBrush x:Key="Color.Text.Secondary" Color="#555555" />
    <SolidColorBrush x:Key="Color.Text.Tertiary" Color="#666666" />
    <SolidColorBrush x:Key="Color.Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Color.Border.Default" Color="#919191" />
    <SolidColorBrush x:Key="Color.Border.Subtle" Color="#919191" />
    <SolidColorBrush x:Key="Color.Separator" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Color.Accent.Primary" Color="#0F6CBD" />
    <SolidColorBrush x:Key="Color.Accent.Hover" Color="#095CA8" />
    <SolidColorBrush x:Key="Color.Accent.Pressed" Color="#084B87" />
    <SolidColorBrush x:Key="Color.Accent.Subtle" Color="#EAF4FF" />
    <SolidColorBrush x:Key="Color.Accent.PressedBackground" Color="#D8EBFF" />
    <SolidColorBrush x:Key="Color.Status.Success" Color="#177A3F" />
    <SolidColorBrush x:Key="Color.Status.SuccessBackground" Color="#F0FDF4" />
    <SolidColorBrush x:Key="Color.Status.SuccessBorder" Color="#3A8A57" />
    <SolidColorBrush x:Key="Color.Status.Warning" Color="#8A5A14" />
    <SolidColorBrush x:Key="Color.Status.WarningBackground" Color="#FFFAEB" />
    <SolidColorBrush x:Key="Color.Status.WarningBorder" Color="#9C681A" />
    <SolidColorBrush x:Key="Color.Status.Error" Color="#C5221A" />
    <SolidColorBrush x:Key="Color.Status.ErrorBackground" Color="#FFF3F2" />
    <SolidColorBrush x:Key="Color.Status.ErrorBorder" Color="#B42318" />
    <SolidColorBrush x:Key="Color.Status.Info" Color="#0F6CBD" />
    <SolidColorBrush x:Key="Color.Status.InfoBackground" Color="#EFF6FF" />
    <SolidColorBrush x:Key="Color.Status.InfoBorder" Color="#4A7FB8" />
    <SolidColorBrush x:Key="Color.Selection.Background" Color="#E8F3FF" />
    <SolidColorBrush x:Key="Color.Focus.Ring" Color="#1677E8" />
    <SolidColorBrush x:Key="Color.Focus.Ring.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.PageBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.ReadinessBackground" Color="#FFFFFF" />
    <DropShadowEffect x:Key="Effect.CardShadow"
                      BlurRadius="16"
                      Direction="270"
                      Opacity="0.08"
                      ShadowDepth="2"
                      Color="#365B7D" />

    <system:Double x:Key="Space.1">4</system:Double>
    <system:Double x:Key="Space.2">8</system:Double>
    <system:Double x:Key="Space.3">12</system:Double>
    <system:Double x:Key="Space.4">16</system:Double>
    <system:Double x:Key="Space.5">20</system:Double>
    <system:Double x:Key="Space.6">24</system:Double>
    <system:Double x:Key="Space.8">32</system:Double>

    <Thickness x:Key="Inset.Command">8</Thickness>
    <Thickness x:Key="Inset.Container.Standard">12</Thickness>
    <Thickness x:Key="Inset.Window.Content">16</Thickness>
    <Thickness x:Key="Inset.Settings.Content">24</Thickness>
    <system:Double x:Key="Metric.Control.Height">36</system:Double>
    <system:Double x:Key="Metric.Control.Height.PrimaryAction">42</system:Double>
    <system:Double x:Key="Metric.Icon.Command.Size">16</system:Double>
    <system:Double x:Key="Typography.Body.Size">14</system:Double>
    <system:Double x:Key="Typography.Caption.Size">12</system:Double>
    <system:Double x:Key="Typography.SectionHeading.Size">16</system:Double>
    <system:Double x:Key="Typography.WindowHeading.Size">20</system:Double>
    <Thickness x:Key="Metric.Border.Thickness">1</Thickness>
    <CornerRadius x:Key="Metric.CornerRadius.Control">6</CornerRadius>
    <CornerRadius x:Key="Metric.CornerRadius.Container">8</CornerRadius>
    <Thickness x:Key="Inset.Control.Compact">8,4</Thickness>
    <Thickness x:Key="Inset.Control.Standard">12,8</Thickness>
    <Thickness x:Key="Inset.Control.PrimaryAction">20,9</Thickness>

    <FontFamily x:Key="Font.Body">Microsoft YaHei UI, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <!-- Retained only for the non-command readiness sample in PrimitiveShowcaseWindow. -->
    <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>

    <Style TargetType="Window">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.PageBackground}" />
    </Style>

    <Style x:Key="BandBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Color.Surface.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Separator}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Inset.Container.Standard}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border" BasedOn="{StaticResource BandBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}" />
        <Setter Property="Effect" Value="{StaticResource Effect.CardShadow}" />
    </Style>

    <Style x:Key="CommandButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource Metric.Control.Height}" />
        <Setter Property="MinHeight" Value="{StaticResource Metric.Control.Height}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Command}" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Metric.Border.Thickness}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CommandButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Metric.CornerRadius.Control}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CommandButtonBorder" Property="Background" Value="{DynamicResource Color.Selection.Background}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CommandButtonBorder" Property="Background" Value="{DynamicResource Color.Accent.PressedBackground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CommandButtonBorder" Property="BorderBrush" Value="{DynamicResource Color.Focus.Ring}" />
                            <Setter TargetName="CommandButtonBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="{StaticResource Metric.Control.Height}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Control.Standard}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Color.Surface.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metric.Border.Thickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="SegmentBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Metric.CornerRadius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource Color.Selection.Background}" />
                            <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource Color.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource Color.Focus.Ring}" />
                            <Setter TargetName="SegmentBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ValidationTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Color.Status.Error}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Size}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource CommandButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource Metric.Control.Height}" />
    </Style>

    <Style x:Key="EditorComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource Metric.Control.Height}" />
        <Setter Property="Background" Value="{DynamicResource Color.Surface.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="DropDownBorder"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Metric.CornerRadius.Control}">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Font.Icon}" FontSize="10"
                                                   Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DropDownBorder" Property="BorderBrush" Value="{DynamicResource Color.Text.Tertiary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="12,4,34,4" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Color.Surface.Secondary}"
                                    BorderBrush="{DynamicResource Color.Border.Default}" BorderThickness="1"
                                    CornerRadius="{StaticResource Metric.CornerRadius.Control}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Color.Focus.Ring}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="CertificateComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource EditorComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource Metric.Control.Height}" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="Padding" Value="{StaticResource Inset.Control.Compact}" />
        <Setter Property="Background" Value="{DynamicResource Color.Surface.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Border.Default}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="{StaticResource Inset.Control.Compact}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Color.Surface.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Metric.CornerRadius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Color.Focus.Ring}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkbenchDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Color.Surface.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metric.Border.Thickness}" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="ColumnHeaderHeight" Value="36" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Color.Separator}" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Color.Surface.Header}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Border.Subtle}" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="MinHeight" Value="{StaticResource Metric.Control.Height.PrimaryAction}" />
        <Setter Property="Padding" Value="{StaticResource Inset.Control.PrimaryAction}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Body.Size}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Color.Accent.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Accent.Primary}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metric.Border.Thickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PrimaryActionBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Metric.CornerRadius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PrimaryActionBorder" Property="Background" Value="{DynamicResource Color.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PrimaryActionBorder" Property="Background" Value="{DynamicResource Color.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PrimaryActionBorder" Property="BorderBrush" Value="{DynamicResource Color.Focus.Ring.OnAccent}" />
                            <Setter TargetName="PrimaryActionBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
